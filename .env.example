# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ADMIN CREDENTIALS (for /panel login)
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="CHANGE_ME"

# PRECIOS DE DEEPSEEK (USD por millón de tokens)
# Se usan para calcular el coste real de cada consulta. Verificar en
# https://api-docs.deepseek.com/quick_start/pricing antes de fiarse: DeepSeek
# ha cambiado tarifas varias veces. Si no se definen, se usan estos valores.
DEEPSEEK_PRICE_INPUT_MISS="0.27"
DEEPSEEK_PRICE_INPUT_HIT="0.07"
DEEPSEEK_PRICE_OUTPUT="1.10"

# Whisper en la nube se factura por minuto de audio, no por tokens.
# Se convierte a tokens equivalentes para mantener una única unidad de saldo.
WHISPER_USD_PER_MINUTE="0.006"
WHISPER_BYTES_PER_SECOND="16000"

# TWILIO CONFIGURATION (Para envío de SMS OTP a números internacionales fuera de Cuba)
TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_AUTH_TOKEN="your_twilio_auth_token_here"
TWILIO_PHONE_NUMBER="+18005550199"
# Opcional: si usas un Messaging Service SID en lugar de un número individual:
# TWILIO_MESSAGING_SERVICE_SID="MGxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# STRIPE CONFIGURATION (cobros con tarjeta fuera de Cuba)
# sk_test_/pk_test_ para pruebas; sk_live_/pk_live_ para cobrar de verdad.
STRIPE_PUBLISHABLE_KEY="TU_CLAVE_PUBLICABLE_DE_STRIPE"
STRIPE_SECRET_KEY="TU_CLAVE_SECRETA_DE_STRIPE"
# Se obtiene al crear el endpoint en https://dashboard.stripe.com/webhooks
# apuntando a  $APP_URL/api/stripe/webhook  con el evento checkout.session.completed.
# Sin esta variable el webhook rechaza TODOS los eventos (503).
STRIPE_WEBHOOK_SECRET="TU_SECRETO_DE_WEBHOOK_DE_STRIPE"
STRIPE_API_VERSION="2026-02-25.clover"
