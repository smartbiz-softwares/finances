# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ADMIN CREDENTIALS (for /panel login)
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="CHANGE_ME"

# PRECIOS DE DEEPSEEK (USD por millón de tokens)
# Se usan para calcular el coste real de cada consulta. Verificar en
# https://api-docs.deepseek.com/quick_start/pricing antes de fiarse: DeepSeek
# ha cambiado tarifas varias veces. Si no se definen, se usan estos valores.
DEEPSEEK_PRICE_INPUT_MISS="0.27"
DEEPSEEK_PRICE_INPUT_HIT="0.07"
DEEPSEEK_PRICE_OUTPUT="1.10"

# Whisper en la nube se factura por minuto de audio, no por tokens.
# Se convierte a tokens equivalentes para mantener una única unidad de saldo.
WHISPER_USD_PER_MINUTE="0.006"
WHISPER_BYTES_PER_SECOND="16000"

# TWILIO CONFIGURATION (Para envío de SMS OTP a números internacionales fuera de Cuba)
TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_AUTH_TOKEN="your_twilio_auth_token_here"
TWILIO_PHONE_NUMBER="+18005550199"
# Opcional: si usas un Messaging Service SID en lugar de un número individual:
# TWILIO_MESSAGING_SERVICE_SID="MGxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# STRIPE CONFIGURATION (cobros con tarjeta fuera de Cuba)
# sk_test_/pk_test_ para pruebas; sk_live_/pk_live_ para cobrar de verdad.
STRIPE_PUBLISHABLE_KEY="TU_CLAVE_PUBLICABLE_DE_STRIPE"
STRIPE_SECRET_KEY="TU_CLAVE_SECRETA_DE_STRIPE"
# Se obtiene al crear el endpoint en https://dashboard.stripe.com/webhooks
# apuntando a  $APP_URL/api/stripe/webhook  con el evento checkout.session.completed.
# Sin esta variable el webhook rechaza TODOS los eventos (503).
STRIPE_WEBHOOK_SECRET="TU_SECRETO_DE_WEBHOOK_DE_STRIPE"
STRIPE_API_VERSION="2026-02-25.clover"

# CORREO (OTP por email). Sin estas variables solo funciona el OTP por SMS.
# Con Gmail hay que usar una "contraseña de aplicación", no la del correo.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="tucorreo@gmail.com"
SMTP_PASS="tu_contraseña_de_aplicacion"
SMTP_FROM="HeraWallet <tucorreo@gmail.com>"

# TRANSCRIPCIÓN (Whisper local). Si el servidor Whisper escucha en otro
# puerto/host, cámbialo aquí. El timeout por defecto son 20s: en CPU lenta
# un dictado largo necesita más que los 3.5s antiguos.
WHISPER_URL="http://127.0.0.1:8080/inference"
WHISPER_TIMEOUT_MS="20000"
# Respaldo de transcripción en la nube (recomendado en producción por si
# Whisper local cae). Groq es barato y rápido:
# GROQ_API_KEY="gsk_..."

# MODO LIVE - VOZ (TTS con Piper, local y gratuito)
# Instalación en el VPS: ver docs/PLAN-MEJORA-IA.md y la guía del README.
# Sin estas variables el Modo Live usa la voz del navegador como fallback.
# Hera tiene voz femenina: es_MX-claude-high (español latino, alta calidad)
# y en_US-amy-medium (inglés).
PIPER_BIN="/opt/piper/piper"
PIPER_VOICE_ES="/opt/piper/voices/es_MX-claude-high.onnx"
PIPER_VOICE_EN="/opt/piper/voices/en_US-amy-medium.onnx"

# SOLO DESARROLLO: con OTP_DEBUG=1 el endpoint /api/send-otp devuelve el código
# en la respuesta JSON. NUNCA activar en producción.
# OTP_DEBUG="1"

# --- Notificaciones push ---
# Se generan una sola vez con:  npx web-push generate-vapid-keys
# Si cambian, todos los dispositivos suscritos dejan de recibir y hay que
# volver a pedirles permiso, así que conviene guardarlas bien.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:soporte@herawallet.app
