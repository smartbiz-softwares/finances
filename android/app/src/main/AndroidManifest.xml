<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Hablar con el servidor de herawallet.app -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Android 13+: sin esto las notificaciones se descartan en silencio. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Adjuntar recibos desde la galería. En Android 13+ el permiso es por
         tipo de archivo; en versiones anteriores basta con el de lectura. -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <!-- Instalar la actualización descargada sin salir de la app. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Dictado por voz y Modo Live -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!-- Foto de recibos y foto de perfil -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- El micrófono y la cámara son opcionales: el teléfono sin ellos
         debe poder instalar la app y usar el resto de funciones. -->
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />


    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>

        <!--
          Dictado desde el widget. Va en su propia tarea y con tema transparente:
          aparece sobre la pantalla de inicio sin dar la sensación de haber
          abierto la app.
        -->
        <activity
            android:name=".DictadoActivity"
            android:exported="false"
            android:theme="@style/TemaDictado"
            android:excludeFromRecents="true"
            android:windowSoftInputMode="adjustResize"
            android:launchMode="singleTop" />

        <!-- Widget de pantalla de inicio -->
        <receiver
            android:name=".WidgetHera"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="app.herawallet.client.REFRESCAR" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_hera_info" />
        </receiver>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
</manifest>
