<?xml version="1.0" encoding="utf-8"?>
<!--
  Widget de pantalla de inicio.

  Jerarquía: el saldo manda, el resto acompaña. Los dos botones ocupan todo el
  ancho inferior con 48dp de alto porque en una pantalla de inicio se pulsan con
  el pulgar, a menudo sin mirar.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_cuerpo"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_fondo"
    android:padding="16dp">

    <!-- Cabecera: marca a la izquierda, racha a la derecha -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="15dp"
            android:layout_height="18dp"
            android:src="@drawable/widget_marca"
            android:contentDescription="HeraWallet" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="7dp"
            android:textColor="#8B857E"
            android:textSize="10sp"
            android:letterSpacing="0.12"
            android:text="SALDO" />

        <TextView
            android:id="@+id/widget_racha"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_pastilla"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:textColor="#D97757"
            android:textSize="10sp"
            android:textStyle="bold"
            android:text="" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_saldo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="#ECE7E1"
        android:textSize="30sp"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end"
        android:includeFontPadding="false"
        android:text="—" />

    <TextView
        android:id="@+id/widget_detalle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:textColor="#B4AEA8"
        android:textSize="12sp"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="" />

    <!-- Acciones abajo, con área de toque cómoda -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="12dp"
        android:orientation="horizontal"
        android:gravity="bottom">

        <TextView
            android:id="@+id/widget_dictar"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1.4"
            android:layout_marginEnd="8dp"
            android:background="@drawable/widget_boton_principal"
            android:gravity="center"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:drawableStart="@drawable/widget_ic_micro"
            android:drawablePadding="7dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="Dictar" />

        <TextView
            android:id="@+id/widget_live"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@drawable/widget_boton"
            android:gravity="center"
            android:textColor="#ECE7E1"
            android:textSize="13sp"
            android:text="Live" />
    </LinearLayout>
</LinearLayout>
