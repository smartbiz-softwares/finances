<?xml version="1.0" encoding="utf-8"?>
<!--
  Widget de pantalla de inicio.

  De arriba abajo: hoy (lo que entró y salió), en qué se va el dinero este mes,
  y el botón para dictar. La racha va en la cabecera, como una insignia.

  Las barras se dibujan con Views de ancho variable en vez de una imagen: un
  widget no puede ejecutar código de dibujo, pero sí se le puede cambiar el peso
  a una vista.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_cuerpo"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_fondo"
    android:padding="14dp">

    <!-- Cabecera: marca, hoy y racha -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="13dp"
            android:layout_height="16dp"
            android:src="@drawable/widget_marca"
            android:contentDescription="HeraWallet" />

        <TextView
            android:id="@+id/widget_hoy"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:textColor="#B4AEA8"
            android:textSize="12sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="" />

        <TextView
            android:id="@+id/widget_racha"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_pastilla"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:textColor="#D97757"
            android:textSize="10sp"
            android:textStyle="bold"
            android:text="" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_saldo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="#ECE7E1"
        android:textSize="26sp"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end"
        android:includeFontPadding="false"
        android:text="—" />

    <!-- En qué se va el dinero este mes -->
    <LinearLayout
        android:id="@+id/widget_grafico"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="10dp"
        android:orientation="vertical">

    <!-- Categoría 1: nombre, barra proporcional e importe -->
    <LinearLayout
        android:id="@+id/widget_cat1"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:baselineAligned="false">

        <TextView
            android:id="@+id/cat1_nombre"
            android:layout_width="60dp"
            android:layout_height="wrap_content"
            android:textColor="#8B857E"
            android:textSize="10sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginHorizontal="7dp"
            android:orientation="horizontal">

            <View
                android:id="@+id/cat1_relleno"
                android:layout_width="0dp"
                android:layout_height="7dp"
                android:layout_weight="1"
                android:background="@drawable/widget_barra_relleno" />

            <View
                android:id="@+id/cat1_hueco"
                android:layout_width="0dp"
                android:layout_height="7dp"
                android:layout_weight="0" />
        </LinearLayout>

        <TextView
            android:id="@+id/cat1_importe"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#ECE7E1"
            android:textSize="11sp"
            android:textStyle="bold"
            android:text="" />
    </LinearLayout>

    <!-- Categoría 2: nombre, barra proporcional e importe -->
    <LinearLayout
        android:id="@+id/widget_cat2"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:baselineAligned="false">

        <TextView
            android:id="@+id/cat2_nombre"
            android:layout_width="60dp"
            android:layout_height="wrap_content"
            android:textColor="#8B857E"
            android:textSize="10sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginHorizontal="7dp"
            android:orientation="horizontal">

            <View
                android:id="@+id/cat2_relleno"
                android:layout_width="0dp"
                android:layout_height="7dp"
                android:layout_weight="1"
                android:background="@drawable/widget_barra_relleno" />

            <View
                android:id="@+id/cat2_hueco"
                android:layout_width="0dp"
                android:layout_height="7dp"
                android:layout_weight="0" />
        </LinearLayout>

        <TextView
            android:id="@+id/cat2_importe"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#ECE7E1"
            android:textSize="11sp"
            android:textStyle="bold"
            android:text="" />
    </LinearLayout>

    <!-- Categoría 3: nombre, barra proporcional e importe -->
    <LinearLayout
        android:id="@+id/widget_cat3"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:baselineAligned="false">

        <TextView
            android:id="@+id/cat3_nombre"
            android:layout_width="60dp"
            android:layout_height="wrap_content"
            android:textColor="#8B857E"
            android:textSize="10sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginHorizontal="7dp"
            android:orientation="horizontal">

            <View
                android:id="@+id/cat3_relleno"
                android:layout_width="0dp"
                android:layout_height="7dp"
                android:layout_weight="1"
                android:background="@drawable/widget_barra_relleno" />

            <View
                android:id="@+id/cat3_hueco"
                android:layout_width="0dp"
                android:layout_height="7dp"
                android:layout_weight="0" />
        </LinearLayout>

        <TextView
            android:id="@+id/cat3_importe"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#ECE7E1"
            android:textSize="11sp"
            android:textStyle="bold"
            android:text="" />
    </LinearLayout>

    </LinearLayout>

    <TextView
        android:id="@+id/widget_dictar"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/widget_boton_principal"
        android:gravity="center"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:textStyle="bold"
        android:drawableStart="@drawable/widget_ic_micro"
        android:drawablePadding="8dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:text="Dictar un gasto" />
</LinearLayout>
