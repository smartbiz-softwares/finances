{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile and settings",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "theme": { "type": "string", "enum": ["light", "dark"] },
        "currency": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email"]
    },
    "Account": {
      "title": "Account",
      "description": "Financial account (Cash, Card, Bank)",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "type": { "type": "string", "enum": ["cash", "card", "bank"] },
        "balance": { "type": "number" },
        "color": { "type": "string" },
        "lastDigits": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "name", "type", "balance"]
    },
    "Transaction": {
      "title": "Transaction",
      "description": "Financial transaction",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "accountId": { "type": "string" },
        "type": { "type": "string", "enum": ["income", "expense"] },
        "amount": { "type": "number" },
        "categoryId": { "type": "string" },
        "description": { "type": "string" },
        "date": { "type": "string", "format": "date-time" },
        "isRecurring": { "type": "boolean" },
        "recurringId": { "type": "string" }
      },
      "required": ["id", "userId", "accountId", "type", "amount", "categoryId", "date"]
    },
    "RecurringTransaction": {
      "title": "RecurringTransaction",
      "description": "Template for recurring transactions",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "accountId": { "type": "string" },
        "type": { "type": "string", "enum": ["income", "expense"] },
        "amount": { "type": "number" },
        "categoryId": { "type": "string" },
        "description": { "type": "string" },
        "frequency": { "type": "string", "enum": ["daily", "weekly", "monthly", "yearly"] },
        "startDate": { "type": "string", "format": "date-time" },
        "nextOccurrence": { "type": "string", "format": "date-time" },
        "isActive": { "type": "boolean" }
      },
      "required": ["id", "userId", "accountId", "type", "amount", "categoryId", "frequency", "startDate", "nextOccurrence", "isActive"]
    },
    "FinancialGoal": {
      "title": "FinancialGoal",
      "description": "User financial goal",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "targetAmount": { "type": "number" },
        "currentAmount": { "type": "number" },
        "deadline": { "type": "string", "format": "date-time" },
        "color": { "type": "string" },
        "icon": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "name", "targetAmount", "currentAmount", "color", "icon", "createdAt"]
    },
    "GoalAutomation": {
      "title": "GoalAutomation",
      "description": "Automation to update goals based on transactions",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "triggerCategoryId": { "type": "string" },
        "targetGoalId": { "type": "string" },
        "type": { "type": "string", "enum": ["percentage", "fixed"] },
        "value": { "type": "number" },
        "isActive": { "type": "boolean" }
      },
      "required": ["id", "userId", "triggerCategoryId", "targetGoalId", "type", "value", "isActive"]
    },
    "GoalContribution": {
      "title": "GoalContribution",
      "description": "History of contributions to a financial goal",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "goalId": { "type": "string" },
        "amount": { "type": "number" },
        "date": { "type": "string", "format": "date-time" },
        "source": { "type": "string", "enum": ["manual", "automation"] },
        "automationId": { "type": "string" }
      },
      "required": ["id", "userId", "goalId", "amount", "date", "source"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile and settings"
    },
    "/users/{userId}/accounts/{accountId}": {
      "schema": "Account",
      "description": "User financial accounts"
    },
    "/users/{userId}/transactions/{transactionId}": {
      "schema": "Transaction",
      "description": "User transactions"
    },
    "/users/{userId}/recurring/{recurringId}": {
      "schema": "RecurringTransaction",
      "description": "User recurring transaction templates"
    },
    "/users/{userId}/goals/{goalId}": {
      "schema": "FinancialGoal",
      "description": "User financial goals"
    },
    "/users/{userId}/automations/{automationId}": {
      "schema": "GoalAutomation",
      "description": "User goal automations"
    },
    "/users/{userId}/goalContributions/{contributionId}": {
      "schema": "GoalContribution",
      "description": "History of goal contributions"
    }
  }
}
