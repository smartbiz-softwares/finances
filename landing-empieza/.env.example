# Copia este archivo como .env (en esta misma carpeta) y completa los datos.
# Sin SMTP la landing funciona igual: las solicitudes se guardan en la base
# solicitudes/empieza.db en vez de enviarse por correo.

# Correo que envía (en Gmail: una "contraseña de aplicación", no la normal).
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="tucorreo@gmail.com"
SMTP_PASS="tu_contraseña_de_aplicacion"
SMTP_FROM="SmartBusiness <tucorreo@gmail.com>"

# A dónde llegan las solicitudes del formulario.
EMPIEZA_CORREO_DESTINO="jcksparrow0209@gmail.com"
# Puerto del servidor local.
EMPIEZA_PUERTO="4100"

# --- Panel de métricas (/panel) -------------------------------------------
# Contraseña para entrar al panel. Sin ella, el panel queda desactivado.
EMPIEZA_PANEL_CLAVE="elige-una-contraseña-larga"
# Clave de la API para tu masterpanel (Authorization: Bearer ...).
EMPIEZA_API_KEY="otra-clave-larga-y-secreta"
# Dominios que pueden llamar a la API desde el navegador, separados por comas.
# EMPIEZA_API_ORIGENES="https://panel.smartbiz.com.uy"
# Cuántas horas antes de cada cita llega el aviso por correo.
EMPIEZA_AVISO_HORAS="5"
# Opcional: carpeta de la base SQLite y sus respaldos (por defecto, solicitudes/).
# EMPIEZA_DATOS="/var/lib/empieza"
